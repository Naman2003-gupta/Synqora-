generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id             String                    @id @default(uuid())
  orderNumber    String                    @unique
  customerId     String
  totalAmount    Decimal                   @db.Decimal(12, 2)
  currency       String                    @default("USD")
  status         String                    @default("PENDING")
  idempotencyKey String                    @unique
  createdAt      DateTime                  @default(now())
  items          OrderItem[]
  transactions   IntegrationTransaction[]

  @@index([createdAt])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model IntegrationTransaction {
  id          String         @id @default(uuid())
  orderId     String
  status      String         @default("PENDING")
  attempts    Int            @default(0)
  sapReference String?
  lastError   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deadLetters DeadLetterJob[]

  @@index([createdAt])
  @@index([status])
  @@index([orderId])
}

model OutboxEvent {
  id          String    @id @default(uuid())
  aggregateId String
  eventType   String
  payload     Json
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([status, createdAt])
}

model DeadLetterJob {
  id            String                 @id @default(uuid())
  transactionId String                 @unique
  errorMessage  String
  attempts      Int
  status        String                 @default("OPEN")
  failedAt      DateTime               @default(now())
  retriedAt     DateTime?
  transaction   IntegrationTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([status, failedAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
