{
  "name": "enterprise-sap-integration",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @sap/api",
    "dev:worker": "npm run dev -w @sap/worker",
    "dev:sap": "npm run dev -w @sap/mock-sap",
    "dev:dashboard": "npm run dev -w @sap/dashboard",
    "stack:up": "docker compose up --build --wait",
    "stack:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "test": "npm run test -w @sap/api"
  },
  "devDependencies": {
    "prisma": "^6.9.0",
    "typescript": "^5.8.3",
    "tsx": "^4.19.4"
  }
}
